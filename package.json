{
  "name": "s4ds",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "start": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "lint": "eslint src vite.config.ts eslint.config.js",
    "format": "prettier --write src vite.config.ts eslint.config.js README.md tsconfig.json package.json",
    "format:check": "prettier --check src vite.config.ts eslint.config.js README.md tsconfig.json package.json",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.0"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^14.0.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "lucide-react": "^0.446.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.18.4",
    "three": "0.180.0"
  },
  "type": "module"
}
